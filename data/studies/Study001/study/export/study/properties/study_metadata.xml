<?xml version="1.0" encoding="UTF-8"?>
<tables xmlns="http://labkey.org/data/xml">
  <table tableName="Personnel" tableDbType="TABLE">
    <description>Contains one row per each study personnel</description>
    <columns/>
  </table>
  <table tableName="Study" tableDbType="TABLE">
    <description>Contains one row per study, describing basic and extended study properties.</description>
    <columns>
      <column columnName="cust_string">
        <datatype>varchar</datatype>
        <columnTitle>cust_string</columnTitle>
        <rangeURI>http://www.w3.org/2001/XMLSchema#string</rangeURI>
        <defaultValueType>FIXED_EDITABLE</defaultValueType>
        <scale>4000</scale>
      </column>
      <column columnName="cust_integer">
        <datatype>integer</datatype>
        <columnTitle>cust_integer</columnTitle>
        <rangeURI>http://www.w3.org/2001/XMLSchema#int</rangeURI>
        <defaultValueType>FIXED_EDITABLE</defaultValueType>
      </column>
      <column columnName="cust_dateTime">
        <datatype>timestamp</datatype>
        <columnTitle>cust_dateTime</columnTitle>
        <rangeURI>http://www.w3.org/2001/XMLSchema#dateTime</rangeURI>
        <defaultValueType>FIXED_EDITABLE</defaultValueType>
      </column>
      <column columnName="cust_double">
        <datatype>double</datatype>
        <columnTitle>cust_double</columnTitle>
        <rangeURI>http://www.w3.org/2001/XMLSchema#double</rangeURI>
        <defaultValueType>FIXED_EDITABLE</defaultValueType>
      </column>
      <column columnName="cust_multiline">
        <datatype>varchar</datatype>
        <inputType>textarea</inputType>
        <columnTitle>cust_multiline</columnTitle>
        <rangeURI>http://www.w3.org/2001/XMLSchema#multiLine</rangeURI>
        <defaultValueType>FIXED_EDITABLE</defaultValueType>
        <scale>4000</scale>
      </column>
    </columns>
  </table>
</tables>